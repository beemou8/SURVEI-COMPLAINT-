<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Suara & Keluhan Member</title>
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-100 min-h-screen flex flex-col justify-between text-slate-800 antialiased font-sans">

  <!-- Container Form Member -->
  <div class="max-w-xl mx-auto w-full p-4 sm:p-6 my-auto">
    <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
      
      <!-- Header -->
      <div class="bg-slate-900 px-6 py-5 text-white">
        <h1 class="text-xl font-bold tracking-tight">Kotak Suara Member</h1>
        <p class="text-slate-400 text-sm mt-1">Sampaikan masukan atau kendala Anda di cabang kami.</p>
      </div>

      <!-- Notifikasi Berhasil -->
      <% if (success) { %>
        <div class="m-6 p-4 bg-emerald-50 border border-emerald-200 rounded-xl flex items-start gap-3">
          <svg class="w-5 h-5 text-emerald-600 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
          </svg>
          <div>
            <h4 class="font-semibold text-emerald-800 text-sm">Keluhan Anda Telah Diterima</h4>
            <p class="text-emerald-700 text-xs mt-0.5">Terima kasih atas masukannya. Suara Anda telah tercatat dan menjadi bahan evaluasi manajemen cabang.</p>
          </div>
        </div>
      <% } %>

      <!-- Form (Hanya 4 Input: Kode Member, Tanggal, Kategori, Keluhan) -->
      <form action="/submit" method="POST" class="p-6 space-y-5">
        
        <!-- 1. Kode Member -->
        <div>
          <label for="kode_member" class="block text-sm font-semibold text-slate-700 mb-1.5">
            1. Kode Member <span class="text-red-500">*</span>
          </label>
          <input 
            type="text" 
            id="kode_member" 
            name="kode_member" 
            required 
            placeholder="Contoh: MBR-1001"
            class="w-full px-3.5 py-2.5 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-blue-600 focus:outline-none uppercase tracking-wider transition"
          >
        </div>

        <!-- 2. Tanggal Kejadian -->
        <div>
          <label for="tanggal" class="block text-sm font-semibold text-slate-700 mb-1.5">
            2. Tanggal Kejadian <span class="text-red-500">*</span>
          </label>
          <input 
            type="date" 
            id="tanggal" 
            name="tanggal" 
            required 
            value="<%= today %>"
            class="w-full px-3.5 py-2.5 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-blue-600 focus:outline-none bg-white transition"
          >
        </div>

        <!-- 3. Kategori Keluhan -->
        <div>
          <label for="category_id" class="block text-sm font-semibold text-slate-700 mb-1.5">
            3. Kategori Keluhan <span class="text-red-500">*</span>
          </label>
          <select 
            id="category_id" 
            name="category_id" 
            required 
            class="w-full px-3.5 py-2.5 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-blue-600 focus:outline-none bg-white transition"
          >
            <option value="" disabled selected>-- Pilih Kategori Masalah --</option>
            <% categories.forEach(function(cat) { %>
              <option value="<%= cat.id %>"><%= cat.nama_kategori %></option>
            <% }); %>
          </select>
        </div>

        <!-- 4. Isi Keluhan -->
        <div>
          <label for="keluhan" class="block text-sm font-semibold text-slate-700 mb-1.5">
            4. Isi Keluhan <span class="text-red-500">*</span>
          </label>
          <textarea 
            id="keluhan" 
            name="keluhan" 
            rows="4" 
            required 
            placeholder="Jelaskan secara singkat kendala atau pengalaman yang Anda alami..."
            class="w-full px-3.5 py-2.5 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-blue-600 focus:outline-none transition"
          ></textarea>
        </div>

        <!-- Tombol Kirim -->
        <div class="pt-2">
          <button 
            type="submit" 
            class="w-full py-3 px-4 bg-blue-600 hover:bg-blue-700 active:bg-blue-800 text-white font-semibold rounded-lg text-sm transition shadow-sm"
          >
            Kirim Keluhan
          </button>
        </div>

      </form>
    </div>

    <!-- Link Akses Manager -->
    <div class="text-center mt-6">
      <a href="/manager" class="text-xs text-slate-500 hover:text-slate-800 transition">
        &rarr; Akses Khusus Monitoring Manager
      </a>
    </div>

  </div>

  <footer class="text-center py-4 text-xs text-slate-400">
    Voice of Member &bull; Internal System
  </footer>

</body>
</html>
